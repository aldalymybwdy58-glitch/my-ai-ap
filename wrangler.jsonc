{
  "name": "my-ai-ap",
  "main": "_worker.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,

  "ai": {
    "binding": "AI"
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
